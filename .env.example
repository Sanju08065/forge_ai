# ─────────────────────────────────────────────────────────────────────────────
# ForgeAI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ── DynamoDB ──────────────────────────────────────────────────────────────────
DYNAMODB_TABLE_NAME=forgeai-main
# Local dev only — remove for production
DYNAMODB_ENDPOINT=http://localhost:8000

# ── S3 ────────────────────────────────────────────────────────────────────────
ARTIFACT_BUCKET_NAME=forgeai-artifacts-123456789012-us-east-1

# ── ECR ───────────────────────────────────────────────────────────────────────
ECR_REPO_URI=123456789012.dkr.ecr.us-east-1.amazonaws.com/forgeai-app

# ── ECS ───────────────────────────────────────────────────────────────────────
ECS_CLUSTER_ARN=arn:aws:ecs:us-east-1:123456789012:cluster/forgeai
ECS_APP_SERVICE_NAME=forgeai-app
ECS_DEV_TASK_DEFINITION=forgeai-dev-runtime
ECS_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
VPC_PRIVATE_SUBNET_IDS=subnet-xxxxxxxxx,subnet-yyyyyyyyy
ECS_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/forgeai-ecs-execution
ECS_TASK_ROLE_ARN=arn:aws:iam::123456789012:role/forgeai-app-task

# ── Step Functions ────────────────────────────────────────────────────────────
FORGEAI_STATE_MACHINE_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:forgeai-engineering-workflow

# ── EventBridge ───────────────────────────────────────────────────────────────
FORGEAI_EVENT_BUS_NAME=forgeai-events

# ── CodeBuild ─────────────────────────────────────────────────────────────────
CODEBUILD_PROJECT_NAME=forgeai-app-build

# ── API (apps/api) ────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Must be at least 32 characters
JWT_SECRET=replace-with-a-real-secret-minimum-32-chars
JWT_EXPIRY_SECONDS=3600
CORS_ORIGIN=http://localhost:5173
APP_VERSION=1.0.0

# ── Orchestrator (services/orchestrator) ─────────────────────────────────────
ORCHESTRATOR_PORT=3001
ORCHESTRATOR_URL=http://localhost:3001

# ── Policy Gateway (services/policy-gateway) ─────────────────────────────────
POLICY_GATEWAY_PORT=3002
POLICY_GATEWAY_URL=http://localhost:3002
FORGEAI_ENVIRONMENT=development

# ── Resource Manager (services/resource-manager) ─────────────────────────────
RESOURCE_MANAGER_PORT=3003
RESOURCE_MANAGER_URL=http://localhost:3003

# ── Agents (services/agents) ─────────────────────────────────────────────────
AGENTS_PORT=3004
WORKSPACE_ROOT=/workspace

# ── Web (apps/web) ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
